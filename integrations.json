{
  "uses": [
    {
      "plugin": "anthropic.api",
      "paths": [
        "src/pubrules/audit_draft.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        "src/pubrules/hosting.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "crates-io.publish",
      "paths": [
        "plugins/rust-crate-quality/.claude-plugin/plugin.json",
        "src/pubrules/audit_prepare.py",
        "src/pubrules/nightly.py",
        "src/pubrules/standard.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "desec.dns",
      "paths": [
        "src/pubrules/hosting.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.actions-oidc",
      "paths": [
        ".github/workflows/service-needs.yml",
        ".github/workflows/wheel.yml",
        "src/pubrules/ci.py",
        "src/pubrules/service_needs.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/ci.yml",
        "src/pubrules/ci.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/workflows/job-tested.yml",
        ".github/workflows/wheel.yml",
        "Makefile",
        "actions/pr-label/",
        "src/pubrules/nightly.py",
        "src/pubrules/protect.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "mailbox.smtp",
      "paths": [
        "src/pubrules/hosting.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "osv.audit",
      "paths": [
        ".github/workflows/job-osv.yml",
        ".github/workflows/node-ci.yml",
        ".github/workflows/python-ci.yml",
        ".github/workflows/rust-ci.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "pypi.publish",
      "paths": [
        "src/pubrules/cli.py",
        "src/pubrules/nightly.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/**",
        "src/pubrules/ci.py"
      ],
      "mode": "required"
    }
  ],
  "other_hosts": [
    {
      "host": "rustup.rs",
      "reason": "A link in an install hint"
    },
    {
      "host": "convergence.sustenaut.eu",
      "reason": "The convergence engine, which the service-needs workflow asks to fulfil a unit (Sustenaut/convergence-engine); a repository may name another in pubrules.json's service-needs block"
    }
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes of these services, which move into the plugins in phase 4"
    },
    {
      "path": "corpus/**",
      "reason": "Release records, not code"
    }
  ]
}
