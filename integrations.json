{
  "uses": [
    {
      "plugin": "anthropic.api",
      "paths": [
        "src/pubkit/audit_draft.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        ".github/workflows/deploy-check.yml",
        ".github/workflows/terraform.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.dns",
      "paths": [
        "actions/deploy-static/action.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        "actions/deploy-static/",
        "src/pubkit/hosting.py",
        "terraform/testdata/pubkit.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "crates-io.publish",
      "paths": [
        ".github/nightly/pubrel-version.sh",
        "plugins/rust-crate-quality/.claude-plugin/plugin.json",
        "src/pubkit/audit_prepare.py",
        "src/pubkit/nightly.py",
        "src/pubkit/standard.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "desec.dns",
      "paths": [
        "src/pubkit/hosting.py",
        "terraform/dns-zone/variables.tf",
        "terraform/testdata/pubkit.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.actions-oidc",
      "paths": [
        ".github/workflows/deploy-check.yml",
        ".github/workflows/terraform.yml",
        "src/pubkit/board_publish.py",
        "src/pubkit/deploy/scheduled.py",
        "src/pubkit/deploy/store.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/ci.yml",
        ".github/workflows/nightly.yml",
        "src/pubkit/ci.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.board-read",
      "paths": [
        "src/pubkit/board/"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/k8s-deploy.yml",
        "src/pubkit/deploy/units.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/nightly/update.sh",
        ".github/workflows/ci.yml",
        ".github/workflows/deploy-check.yml",
        ".github/workflows/job-tested.yml",
        ".github/workflows/k8s-deploy.yml",
        ".github/workflows/nightly.yml",
        ".github/workflows/terraform.yml",
        "Makefile",
        "actions/pr-label/",
        "src/pubkit/deploy/",
        "src/pubkit/nightly.py",
        "src/pubkit/protect.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        ".github/workflows/terraform.yml",
        "terraform/cloud-run-access/",
        "terraform/cloud-run-service/",
        "terraform/cloud-run-sites/"
      ],
      "mode": "required"
    },
    {
      "plugin": "mailbox.smtp",
      "paths": [
        "src/pubkit/dns.py",
        "src/pubkit/hosting.py",
        "terraform/hosting/variables.tf",
        "terraform/testdata/pubkit.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "openssf.scorecard",
      "paths": [
        "src/pubkit/board/connectors/scorecard.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "osv.audit",
      "paths": [
        ".github/workflows/job-osv.yml",
        ".github/workflows/node-ci.yml",
        ".github/workflows/python-ci.yml",
        ".github/workflows/rust-ci.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "pypi.publish",
      "paths": [
        "src/pubkit/cli.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "slack.post",
      "paths": [
        ".github/nightly/update.sh",
        ".github/workflows/nightly.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.read",
      "paths": [
        "src/pubkit/board/"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/**",
        "src/pubkit/ci.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "tailscale.tailnet",
      "paths": [
        ".github/workflows/deploy-check.yml",
        ".github/workflows/k8s-deploy.yml",
        "actions/deploy-ssh/",
        "src/pubkit/deploy/implied.py"
      ],
      "mode": "required"
    }
  ],
  "terraform": [
    {
      "dir": "terraform/backup-bucket",
      "plugins": [
        "terraform.google"
      ],
      "runs": [],
      "mode": "required"
    },
    {
      "dir": "terraform/cloud-run-access",
      "plugins": [
        "terraform.google"
      ],
      "runs": [],
      "mode": "required"
    },
    {
      "dir": "terraform/cloud-run-service",
      "plugins": [
        "terraform.google"
      ],
      "runs": [],
      "mode": "required"
    },
    {
      "dir": "terraform/cloud-run-sites",
      "plugins": [
        "terraform.google"
      ],
      "runs": [],
      "mode": "required"
    },
    {
      "dir": "terraform/desec-zones",
      "plugins": [
        "terraform.desec"
      ],
      "runs": [],
      "mode": "required"
    },
    {
      "dir": "terraform/dns-zone",
      "plugins": [
        "terraform.cloudflare",
        "terraform.hetzner"
      ],
      "runs": [],
      "mode": "required"
    },
    {
      "dir": "terraform/hosting",
      "plugins": [
        "terraform.cloudflare",
        "terraform.hetzner"
      ],
      "runs": [],
      "mode": "required"
    }
  ],
  "other_hosts": [
    {
      "host": "rustup.rs",
      "reason": "A link in an install hint"
    }
  ],
  "other_secrets": [
    {
      "name": "PUBKIT_BUMP_TOKEN",
      "reason": "The nightly's fallback GitHub token, for when no app is set up; it reaches only GitHub"
    },
    {
      "name": "SUSTENAUT_DEPLOY_SSH_KEY",
      "reason": "k8s-deploy.yml's SSH key to a caller's k3s server, which the server pins to its deploy program"
    }
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes of these services, which move into the plugins in phase 4"
    },
    {
      "path": "corpus/**",
      "reason": "Release records, not code"
    }
  ]
}
